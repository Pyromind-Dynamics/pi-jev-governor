# pi-jev 环境变量模板 — 复制为 .env.local 并填入真实值
#   cp .env.local.example .env.local

# JEV 决策服务 key（默认 endpoint 为 OpenRouter decisions API）
export PI_JEV_API_KEY=""

# 决策请求总超时 ms（默认 3000；decisions 实测延迟常见 2–4s，建议 10000）
export PI_JEV_TIMEOUT_MS=10000

# pi 调用模型所用 provider 的 key（OpenRouter 全模型则同上一把）
export OPENROUTER_API_KEY=""

# 三档路由模型，provider:modelId 格式（须能被 pi 解析且 provider 已鉴权）
export PI_JEV_MODEL_SMALL="openrouter:qwen/qwen3.7-flash"
export PI_JEV_MODEL_NORMAL="openrouter:qwen/qwen3.7-plus"
export PI_JEV_MODEL_STRONG="openrouter:qwen/qwen3.7-max"

# 置信度阈值（代码默认 0.8/0.9/0.8，较保守；MATH-500 评测用 0.5 更积极触发路由/校验）
# export PI_JEV_ROUTE_CONFIDENCE=0.5
# export PI_JEV_PERMISSION_CONFIDENCE=0.5
# export PI_JEV_OUTCOME_CONFIDENCE=0.5

# 决策日志目录（缺省为 macOS ~/Library/Application Support/pi-jev）
export PI_JEV_LOG_DIR="$HOME/.pi-jev-logs"
